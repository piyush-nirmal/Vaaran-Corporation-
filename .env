# Varan Corporation (VRN) Environment Variables
# You can update these values anytime with your production credentials.

# 1. Lead Delivery Endpoint
# Leave blank to test with local persistence (stored in localStorage 'vrn_lead_queue').
# When ready, paste your Formspree endpoint, Google Sheets webhook URL, or CRM API:
# Example: https://formspree.io/f/your_form_id
VITE_LEAD_ENDPOINT=

# 2. WhatsApp Business Direct Routing
# Digits only with country code (e.g. 919876543210 for India +91):
VITE_WHATSAPP_NUMBER=919876543210
